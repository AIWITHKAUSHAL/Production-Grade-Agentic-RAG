# ========================
# EURI API Configuration
# ========================
EURI_API_KEY=your_euri_api_key_here
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_MODEL=gemini-3.5-flash-lite
EURI_EMBEDDING_MODEL=text-embedding-3-small

# ========================
# Qdrant Cloud
# ========================
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=agentic_rag_docs

# ========================
# MongoDB (Checkpoints)
# ========================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=agentic_rag_db
MONGODB_CHECKPOINT_COLLECTION=checkpoints

# ========================
# LangSmith Tracing
# ========================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=production-agentic-rag
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ========================
# Web Search
# ========================
TAVILY_API_KEY=your_tavily_api_key_here

# ========================
# Application Settings
# ========================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Agent Settings
MAX_RETRIES=3
MAX_DOCUMENTS=10
RETRIEVAL_K=5
RERANK_TOP_K=3
HYBRID_ALPHA=0.5

# Chunking Settings
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
